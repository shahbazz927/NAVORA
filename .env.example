# ============================================================================
# NAVORA AI Career Advisor — OpenRouter configuration
# ----------------------------------------------------------------------------
# The browser never talks to the AI provider directly. These values are read by
# the Node backend (server/server.mjs) at http://localhost:3001, which is the
# only process allowed to contact OpenRouter.
#
# Copy this file to .env (or add these lines to an existing .env) and set
# OPENROUTER_API_KEY to a valid OpenRouter API key (https://openrouter.ai/keys).
# ============================================================================

# Port the NAVORA AI backend listens on (the frontend proxies /api/* here).
PORT=3001

# Your OpenRouter API key (required). Get one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Base URL of the OpenRouter API (OpenAI-compatible Chat Completions).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# The model used for career advice.
# The primary is tried first; on transient provider failures (429/5xx/timeout)
# the backend retries each fallback model in turn. Use a currently-available
# free model (check https://openrouter.ai/models?q=free) or any paid one you
# have credits for. OPENROUTER_MODEL is kept for backwards compatibility and is
# treated as the primary model when AI_PRIMARY_MODEL is not set.
AI_PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_FALLBACK_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openrouter/free

# Maximum number of distinct models to attempt before giving up (default 3).
MAX_MODEL_ATTEMPTS=4

# OpenRouter request attribution headers (recommended by OpenRouter).
OPENROUTER_SITE_URL=https://navora.in
OPENROUTER_APP_NAME=NAVORA

# Optional: max time (ms) to wait for a single model response (default 30000).
# OPENROUTER_TIMEOUT_MS=30000

# Optional: per-IP request limit for the AI endpoints (requests per minute).
# AI_RATE_LIMIT_PER_MIN=30